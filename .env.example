# ==============================================================
# DOCE & PEDIDO — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o arquivo .env.local no repositório.
# ==============================================================

# --- Supabase (obrigatório para a área administrativa) ---
# Crie o projeto em https://supabase.com e copie as chaves em
# Project Settings > API. Use a chave "anon public" (nunca a service_role no frontend).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public

# --- Configuração da confeitaria (pública, usada no site) ---
# Número do WhatsApp no formato internacional, APENAS dígitos.
# Exemplo Brasil: 5511999998888 (55 + DDD + número)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999998888
NEXT_PUBLIC_INSTAGRAM=doceepedido

# Nome da cidade para SEO (deixe vazio se ainda não quiser exibir)
NEXT_PUBLIC_CITY=
